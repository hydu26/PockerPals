# Supabase — lấy từ dashboard.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role — Project Settings → API → service_role (KHÔNG commit key này)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# URL gốc của app — dùng cho invite email redirect
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude API — server-side only, không bao giờ expose ra client
ANTHROPIC_API_KEY=sk-ant-your_key_here
